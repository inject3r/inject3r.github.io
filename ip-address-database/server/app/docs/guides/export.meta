{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/docs/layout,_N_T_/docs/guides/layout,_N_T_/docs/guides/export/layout,_N_T_/docs/guides/export/page,_N_T_/docs/guides/export"
  },
